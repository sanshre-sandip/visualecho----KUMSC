# Copy this file to .env and fill in your values.
# .env is ignored by Git and must never be committed.

# Google Gemini cloud LLM key. Server-side only; never sent to the mobile app.
GEMINI_API_KEY=

# Model identifier used for cloud requests. Change here without code changes.
GEMINI_MODEL=gemini-3.8-flash

# Comma-separated browser origins allowed by CORS. Empty disables CORS.
CORS_ORIGINS=

# development | production
ENVIRONMENT=development
