# Copy this file to .env and fill in your values.
# .env is ignored by Git and must never be committed.

# Google Gemini cloud LLM key. Server-side only; never sent to the mobile app.
GEMINI_API_KEY=

# Model identifier used for cloud requests. Change here without code changes.
GEMINI_MODEL=gemini-3.8-flash

# Upstream Gemini request timeout in seconds (1-300).
LLM_TIMEOUT_SECONDS=20

# Maximum accepted request body size in bytes.
MAX_REQUEST_BYTES=6000000

# Comma-separated browser origins allowed by CORS.
# Empty: development falls back to Expo/Metro localhost origins, production
# disables CORS. Use * only for local testing, never in production.
CORS_ORIGINS=

# development | production
ENVIRONMENT=development
